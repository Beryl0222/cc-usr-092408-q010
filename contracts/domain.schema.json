{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "地方小吃公用品牌治理领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STORE_APPLIED",
        "STANDARD_ACCEPTED",
        "INSPECTION_RECORDED",
        "AUTHORIZATION_PAUSED",
        "REMEDIATION_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "brand_operator",
        "authorized_store",
        "standard_version",
        "compliance_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
